  "grille": {
    "total_points": 100,
    "criteres": [
      {
        "critere": "Site fonctionnel",
        "points": 20,
        "verifie": "Page d'accueil accessible en HTTPS, hors maintenance"
      },
      {
        "critere": "robots.txt",
        "points": 10,
        "verifie": "Fichier present a la racine, servi en texte"
      },
      {
        "critere": "Sitemap XML",
        "points": 15,
        "verifie": "Plan de site valide, declare dans robots.txt ou aux adresses standard"
      },
      {
        "critere": "Meta-description presente",
        "points": 10,
        "verifie": "Balise presente sur la page d'accueil"
      },
      {
        "critere": "Meta-description de longueur optimale",
        "points": 5,
        "verifie": "120 a 160 caracteres"
      },
      {
        "critere": "Regles explicites pour les robots d'IA",
        "points": 10,
        "verifie": "Au moins un robot d'IA nomme dans robots.txt"
      },
      {
        "critere": "llms.txt",
        "points": 15,
        "verifie": "Vrai fichier texte a la racine, pas une page HTML"
      },
      {
        "critere": "Article Wikipedia en francais",
        "points": 15,
        "verifie": "Article consacre a l'organisation"
      }
    ]
  },
  "methode": {
    "echantillon": "30 organisations camerounaises de premier plan, 10 par secteur.",
    "protocole": "Chaque domaine est sollicite en HTTPS, d'abord sur l'apex puis sur le sous-domaine www en cas d'echec, avec trois tentatives espacees. Le critere Wikipedia est verifie via l'API MediaWiki : une reponse vide n'est jamais interpretee comme une absence d'article.",
    "correction_domaines": "Le premier passage s'est execute derriere un proxy qui a renvoye 502 sur six organisations. Au second passage, cinq des six domaines de l'echantillon se sont reveles errones ou morts et ont ete corriges contre une source primaire. Le detail figure dans corrections_domaines.",
    "limites": "Le barometre mesure la preparation technique des sites a etre lus par des robots d'IA. Il ne mesure pas si une IA donnee cite effectivement une organisation, ce qui varie selon la question posee et l'utilisateur. La meta-description est relevee sur la page d'accueil uniquement."
  },
