# Copy to .env.local for local dev, and set these in the Vercel dashboard for
# production. See docs/DEPLOYMENT.md.

# Required. Canonicals, OG URLs and the sitemap are all built from this.
NEXT_PUBLIC_SITE_URL=https://afrishieldai.com

# Optional. HubSpot private-app token for lead capture.
# Unset, /api/contact still accepts submissions and logs them — it just does not
# forward. Nothing breaks.
HUBSPOT_TOKEN=

# Add after verifying the property in Google Search Console, then redeploy.
# Do not guess this value — Google issues a unique hash per property.
GOOGLE_SITE_VERIFICATION=

# Same, from Bing Webmaster Tools.
BING_SITE_VERIFICATION=

# Optional. Only needed to REFRESH site imagery via scripts/pull-pexels.mjs.
# Images are already downloaded to public/images, so this is not needed to run
# or deploy the site. Get a free key at https://www.pexels.com/api/
PEXELS_API_KEY=
