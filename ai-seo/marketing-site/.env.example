# Copy to .env.local for local dev, and set these in the Vercel dashboard for
# production. See docs/DEPLOYMENT.md.

# Required. Canonicals, OG URLs and the sitemap are all built from this.
NEXT_PUBLIC_SITE_URL=https://afrishieldai.com

# Optional. HubSpot private-app token. Leads are stored in Supabase either way;
# set this to also forward each one to HubSpot. Unset, nothing breaks.
HUBSPOT_TOKEN=

# Lead storage. Every /api/contact submission (with its affiliate ref) is
# written to the `site_leads` table — see supabase/migrations/. Server-side
# only: never give the service-role key a NEXT_PUBLIC_ prefix. Unset, leads
# are still accepted and logged in full, just not stored.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Inbound AI call line (Vapi + Twilio). Only set this to override the default
# number in lib/site.ts — it changes every phone UI element and the JSON-LD
# telephone at once. Format is display text, e.g. "+1 (559) 543-5844".
NEXT_PUBLIC_PHONE=

# Shared secret between the voice platform (Vapi) and /api/call-summary.
# Generate with `openssl rand -hex 32` and configure Vapi to send it as the
# x-call-webhook-secret header. Unset, the webhook accepts with a warning.
CALL_WEBHOOK_SECRET=

# Add after verifying the property in Google Search Console, then redeploy.
# Do not guess this value — Google issues a unique hash per property.
GOOGLE_SITE_VERIFICATION=

# Optional. Google Business Profile "write a review" short link
# (https://g.page/r/<id>/review) or the Place ID form. Unset, /review detects
# the empty value and leads with the on-site form instead, so the page is safe
# to share before the profile exists. Set it and the Google button goes live.
# Never gate this behind a rating — it stays available to every customer
# whatever they scored. That is Google review policy, not a preference.
NEXT_PUBLIC_GOOGLE_REVIEW_URL=

# Same, from Bing Webmaster Tools.
BING_SITE_VERIFICATION=

# Optional. Only needed to REFRESH site imagery via scripts/pull-pexels.mjs.
# Images are already downloaded to public/images, so this is not needed to run
# or deploy the site. Get a free key at https://www.pexels.com/api/
PEXELS_API_KEY=

# Optional. HeyGen API key for generating video/image/UGC content (avatars,
# talking-head clips, etc). Not read by the site itself — used ad hoc via
# scripts/curl against api.heygen.com. Get it from HeyGen > API Settings.
HEYGEN_API_KEY=
